+class _ObservationFallbackCost:
+    """Charge all work globally; keep the original primary-candidate cap."""
+    def __init__(self,cost):self.cost=cost
+    def __getitem__(self,key):
+        if key=='forecast_calls':return self.cost.get('observation_fallback_forecast_calls',0)
+        return self.cost[key]
+    def __setitem__(self,key,value):
+        self.cost['observation_fallback_forecast_calls' if key=='forecast_calls' else key]=value
+    def setdefault(self,key,value):
+        return self.cost.setdefault('observation_fallback_forecast_calls' if key=='forecast_calls' else key,value)
+
+
+def choose_with_joint_feasibility(root,high,low,progress,counter,cost,max_ticks=60000,history=(0,0),geometry=None):
+    alternate=high.get('observation_fallback')
+    if alternate is None:
+        return _choose_without_observation_guard(root,high,low,progress,counter,cost,max_ticks,history,geometry)
+    original_certifier=core.certifier
+    def guarded_certifier(r,path,backup_path,s,count,planner,context,limit=60000,history=(0,0)):
+        primary=original_certifier(r,path,backup_path,s,count,planner,context,limit,history)
+        shadow=original_certifier(r,alternate['high'],alternate['low'],alternate['progress'],count,_ObservationFallbackCost(planner),context,limit,history)
+        def certify(action):
+            other=shadow(action)
+            if not other['ok']:
+                return dict(other,reason='OBSERVATION_FALLBACK_'+other['reason'],observation_fallback=other)
+            report=primary(action)
+            if not report['ok']:return dict(report,observation_fallback=other)
+            combined=dict(report,observation_fallback=other,
+                peak=max(report['peak'],other['peak']),
+                max_reference_overspeed=max(report['max_reference_overspeed'],other['max_reference_overspeed']),
+                min_footprint_margin_m=min(report['min_footprint_margin_m'],other['min_footprint_margin_m']))
+            return combined
+        return certify
+    core.certifier=guarded_certifier
+    try:return _choose_without_observation_guard(root,high,low,progress,counter,cost,max_ticks,history,geometry)
+    finally:core.certifier=original_certifier
+
+
