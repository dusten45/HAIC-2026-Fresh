+def observed_row_fallback_reference(raw_points,obstacles,com,distance):
+    """The existing row-reference branch, as a current-observation contingency.
+
+    It adds certification constraints only, never road support or unseen path.
+    """
+    points=np.asarray(raw_points,np.float64).copy()
+    points[:,0]=cv2.GaussianBlur(points[:,0].reshape(1,-1),(5,1),1.).ravel()
+    source=np.r_[0.,np.cumsum(np.linalg.norm(np.diff(points,axis=0),axis=1))]
+    points=deform_observed_reference(points,points.copy(),source,obstacles)
+    curvature=observed_reference_curvature(points)
+    arc=np.r_[0.,np.cumsum(np.linalg.norm(np.diff(points,axis=0),axis=1))]
+    current=observed_reference_progress(points,arc,com)
+    def profile(budget,max_speed):
+        q=np.minimum(max_speed**2,budget/np.maximum(curvature,1e-6));q[-1]=0.
+        for i in range(len(q)-2,-1,-1):q[i]=min(q[i],q[i+1]+2*45.*(arc[i+1]-arc[i]))
+        q=np.minimum(q,2*core.REAR*np.maximum(0.,distance+arc-current))
+        return dict(points=points.tolist(),arcs=arc.tolist(),ds=np.diff(arc).tolist(),length=float(arc[-1]),
+            launch_squared=q.tolist(),periodic_squared=q[:-1].tolist(),observed_open=True)
+    return dict(high=profile(153.,90.),low=profile(100.,80.),progress=current)
